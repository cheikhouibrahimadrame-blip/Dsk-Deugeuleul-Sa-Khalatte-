# ---------------------------------------------------------------------------
# DSK environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://dsk:dsk_dev_password@localhost:5432/dsk?schema=public

# --- Redis (BullMQ queues, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Realtime gateway (Socket.IO, apps/realtime) ---
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# Optional dedicated secret for socket connection tokens (falls back to NEXTAUTH_SECRET)
REALTIME_JWT_SECRET=

# --- Auth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Security ---
# 32-byte hex key used to encrypt provider tokens at rest (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Unguessable path segment for the hidden admin panel (not linked in any navigation)
ADMIN_PANEL_PATH=panel-x7k9

# --- Email (stubbed Mailer in dev; wire a real provider in prod) ---
EMAIL_FROM=no-reply@dsk.local
SMTP_URL=

# --- Meta integrations (Facebook Pages / Instagram professional / WhatsApp Business) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# --- TikTok integration (separate provider family) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
