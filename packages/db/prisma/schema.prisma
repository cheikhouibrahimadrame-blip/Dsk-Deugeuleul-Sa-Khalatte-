// This is your Prisma schema.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSeenAt        DateTime? // For online status
  isOnline          Boolean   @default(false)
  
  // AI Matching Fields
  interests         String[]  @default([])
  skills            String[]  @default([])
  embedding         Json?     // Vector embedding for similarity search
  
  // Relationships
  goals             Goal[]
  memberships       Membership[]
  chats             ChatMember[]
  messages          Message[]
  notifications     Notification[]
  sentMessages      Message[] @relation("MessageSender")
  matchScores       MatchScore[] @relation("UserOne")
  matchScoresTwo    MatchScore[] @relation("UserTwo")
  
  @@index([email])
  @@index([interests])
  @@index([skills])
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  status      String   @default("active") // active, completed, paused
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // AI Matching Fields
  embedding     Json?    // Vector embedding for similarity search
  matchedWith   Goal[]   @relation("GoalMatches")
  
  // Relationships
  memberships   Membership[]
  chatRooms     ChatRoom[]
  
  @@index([userId])
  @@index([status])
  @@index([category])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  role      String   @default("member") // owner, member
  joinedAt  DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  goal      Goal     @relation(fields: [goalId], references: [id])
  
  @@unique([userId, goalId])
  @@index([goalId])
}

// ============================================
// AI MATCHING MODELS
// ============================================

model MatchScore {
  id          String   @id @default(cuid())
  userIdOne   String
  userIdTwo   String
  score       Float    // 0.0 to 1.0 compatibility score
  reason      String?  // AI-generated explanation
  createdAt   DateTime @default(now())
  
  userOne     User     @relation("UserOne", fields: [userIdOne], references: [id])
  userTwo     User     @relation("UserTwo", fields: [userIdTwo], references: [id])
  
  @@unique([userIdOne, userIdTwo])
  @@index([userIdOne])
  @@index([userIdTwo])
  @@index([score])
}

// ============================================
// CHAT MODELS
// ============================================

model ChatRoom {
  id          String   @id @default(cuid())
  name        String?  // For group chats
  type        String   @default("direct") // direct, group, goal
  goalId      String?  // If linked to a goal
  goal        Goal?    @relation(fields: [goalId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  members     ChatMember[]
  messages    Message[]
  
  @@index([goalId])
  @@index([type])
}

model ChatMember {
  id         String   @id @default(cuid())
  chatRoomId String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime?
  
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([chatRoomId, userId])
  @@index([userId])
  @@index([chatRoomId])
}

model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text
  type        String   @default("text") // text, image, file, system
  metadata    Json?    // For file URLs, reactions, etc.
  chatRoomId  String
  senderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender      User?    @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  
  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS MODEL
// ============================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // message, goal_update, mention, system
  title       String
  body        String   @db.Text
  data        Json?    // { chatRoomId, messageId, goalId, etc. }
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  
  // Relationships
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
}

// ============================================
// OPTIONAL: REACTIONS (for messages)
// ============================================

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  createdAt DateTime @default(now())
  
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ============================================
// GOAL MATCHES (Many-to-Many)
// ============================================

model GoalMatch {
  id        String   @id @default(cuid())
  goalOneId String
  goalTwoId String
  score     Float
  createdAt DateTime @default(now())
  
  goalOne   Goal     @relation("GoalMatches", fields: [goalOneId], references: [id])
  goalTwo   Goal     @relation("GoalMatches", fields: [goalTwoId], references: [id])
  
  @@unique([goalOneId, goalTwoId])
  @@index([goalOneId])
  @@index([goalTwoId])
  @@index([score])
}
